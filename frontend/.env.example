# 로컬·시연용 설정 예시.
# 이 파일을 frontend/.env.local 로 복사해서 쓴다 (.env.local 은 git 에 올라가지 않는다).
#
#   cp frontend/.env.example frontend/.env.local

# AI 소비 판정이 열리는 시각(0~23). 운영 기본값은 20(저녁 8시).
# 1학기 4차 회의에서 정한 주작 방지 규칙이라 평소에는 20 이 맞다.
# 다만 발표·시연은 낮에 하므로 0 으로 두면 하루 종일 열린다.
# ⚠️ 시연이 끝나면 되돌릴 것.
REACT_APP_AI_ACTIVE_FROM_HOUR=0

# 백엔드 주소를 바꿔야 할 때만. 기본값은 http://localhost:8080/api
# REACT_APP_API_BASE=http://localhost:8080/api
