# 프론트 환경변수 — 이 파일을 .env.local 로 복사해 채운다 (.env.local 은 gitignore).
# CRA 는 REACT_APP_ 접두사만 노출하고, 값을 바꾸면 npm start 를 다시 해야 한다.

# 구글 로그인 — Google Cloud 콘솔 OAuth 클라이언트 ID(웹 애플리케이션).
# 백엔드 .env 의 GOOGLE_CLIENT_ID 와 같은 값. 비워 두면 로그인 화면에 구글 버튼이 뜨지 않는다.
REACT_APP_GOOGLE_CLIENT_ID=

# 소비 판정이 열리는 시각 (0~23, 기본 20). 낮 시연이면 0. 백엔드 .env 의 vori.ai-judge.open-hour 와 함께.
# REACT_APP_AI_ACTIVE_FROM_HOUR=0
