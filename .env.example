# Copy this file to .env and fill in your local values.
# Never commit .env or real passwords/API keys.
DB_USERNAME=root
DB_PASSWORD=

GEMINI_API_KEY=
# Optional model overrides (defaults in backend application.properties).
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# === Google 로그인 ===
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션).
# 같은 값을 frontend/.env.local 의 REACT_APP_GOOGLE_CLIENT_ID 에도 넣는다. 비워 두면 구글 버튼이 숨는다.
GOOGLE_CLIENT_ID=

# Optional demo setting (0-23; default: 20).
# Also set REACT_APP_AI_ACTIVE_FROM_HOUR in frontend/.env.local.
# vori.ai-judge.open-hour=0
