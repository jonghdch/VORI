# === Database (MySQL) ===
DB_USERNAME=root
DB_PASSWORD=__REDACTED__

# === Gemini API ===
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=__REDACTED__

# 사용할 모델 (기본값: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# === Google 로그인 ===
# Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션).
# 같은 값을 frontend/.env.local 의 REACT_APP_GOOGLE_CLIENT_ID 에도 넣는다. 비워 두면 구글 버튼이 숨는다.
GOOGLE_CLIENT_ID=

# === 소비 판정이 열리는 시각 (0~23, 기본 20) ===
# 낮에 하는 발표·시연에서는 0 으로 두고, frontend/.env.local 의
# REACT_APP_AI_ACTIVE_FROM_HOUR 도 함께 0 으로 맞춘다. 시연이 끝나면 되돌린다.
# vori.ai-judge.open-hour=0
