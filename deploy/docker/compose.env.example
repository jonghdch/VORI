# docker compose 보간용 — 서버 /data/home2/vori.worldpick.co.kr/.env (root 소유, 권한 600)
# docker-compose.yml 의 ${MYSQL_ROOT_PASSWORD}·${DB_PASSWORD} 자리에 들어간다. 앱 설정은 이 파일이 아니라 VORI/.env(app.env.example).
# 값은 길고 무작위로 채우고 저장소에 올리지 않는다(.gitignore 가 deploy/docker/*.env 를 막는다).

# MySQL root 비밀번호 — vori-mysql 컨테이너가 처음 만들어질 때(mysql-data 가 비어 있을 때) 적용된다
MYSQL_ROOT_PASSWORD=
# 앱 전용 DB 사용자 `vori` 의 비밀번호 — VORI/.env 의 DB_PASSWORD 와 반드시 같은 값
# (mysql-data 가 이미 만들어진 뒤에 여기만 바꾸면 DB 쪽 비밀번호는 안 바뀐다. 바꾸려면 MySQL 안에서 ALTER USER)
DB_PASSWORD=
