# VORI 운영 앱 설정 — 서버 /data/home2/vori.worldpick.co.kr/VORI/.env (vori 소유, 권한 600, gitignore 대상)
# vori-backend 컨테이너는 작업 디렉터리 /app(= 이 레포 루트)의 .env 를 properties 로 읽는다
# (application.properties 의 spring.config.import). 그래서 환경변수 이름(DB_PASSWORD)도
# 설정 이름(vori.ai-judge.open-hour)도 그대로 쓸 수 있다. 값에 따옴표를 붙이지 않는다. 줄바꿈은 LF.
#
# 값을 바꾼 뒤에는 서버에서 deploy.sh 를 한 번 실행한다 — .env 변경을 감지해 백엔드를 재기동하고,
# GOOGLE_CLIENT_ID·vori.ai-judge.open-hour 가 바뀌었으면 프론트도 다시 빌드한다.
#   ssh zzemsoft 'cd /data/home2/vori.worldpick.co.kr && runuser -u vori -- ./deploy.sh'
# 이 파일은 키 이름 목록(값은 비움)이다. 실제 값은 서버 파일이 원본이다.

# === DB === (vori-mysql 컨테이너, internal 네트워크 vori_private)
DB_USERNAME=vori
# compose 루트 .env 의 DB_PASSWORD 와 같은 값
DB_PASSWORD=
# 컨테이너 환경에서는 필수다. 기본값(127.0.0.1:3306)은 컨테이너 자기 자신이라 연결이 안 된다 → 서비스 이름 vori-mysql 로 쓴다.
spring.datasource.url=jdbc:mysql://vori-mysql:3306/vori?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# === 관리자 계정 ===
# 관리자(admin@vori.com)가 아직 없을 때 첫 실행에서만 이 비밀번호로 만든다. 비우면 만들지 않는다.
# 저장소가 공개라 1234 같은 값은 누구나 안다 — 길고 다른 값으로.
ADMIN_PASSWORD=

# === 사용자가 채워야 하는 키 ===
# Gemini 서버 키 — 유료(결제 등록) 프로젝트 키 권장. 비어 있으면 AI 기능(카테고리 분류·질문·펫 대화·영수증)이 동작하지 않는다.
GEMINI_API_KEY=
# Google OAuth 웹 클라이언트 ID — 프론트 빌드(REACT_APP_GOOGLE_CLIENT_ID)에도 같은 값이 들어간다(deploy.sh 가 읽어 넘기고 자동 재빌드).
# 비우면 구글 로그인 버튼이 숨는다. Google Cloud 콘솔 > 그 OAuth 클라이언트 > 승인된 JavaScript 원본에 https://vori.worldpick.co.kr 추가.
GOOGLE_CLIENT_ID=

# === 판정 시각 ===
# 평소 20. 낮 발표·경진대회 기간에는 0. 프론트 REACT_APP_AI_ACTIVE_FROM_HOUR 도 이 값으로 빌드된다(deploy.sh 가 읽어 넘김 — 한 곳만 바꾸면 된다).
# 단 JudgmentOpenNotifier 의 알림 시각은 20시 고정이라 이 값을 따라가지 않는다.
vori.ai-judge.open-hour=20
# 다음 날 새벽 이 시각 전까지 판정할 수 있고(0시~이 시각은 전날 판정), 정산도 이 시각에 돈다. 기본 2.
# 프론트 config.js 의 AI_ACTIVE_UNTIL_HOUR(2 고정)와 같아야 해서 보통은 넣지 않는다. open-hour=0 이면 새벽 연장 없음.
# vori.ai-judge.close-hour=2

# === HTTPS (nginx 컨테이너가 TLS 종료) ===
# 세션 쿠키를 https 에서만 보낸다. 운영은 켠다.
# application-prod.properties 의 기본값이 이미 true 라서 SESSION_COOKIE_SECURE 키를 따로 안 넣어도 켜진다
# (http 로만 시험하는 동안에는 SESSION_COOKIE_SECURE=false 로 꺼야 쿠키가 붙어 로그인된다).
server.servlet.session.cookie.secure=true
# nginx 가 넘기는 X-Forwarded-Proto 를 믿는다(서버가 https 요청임을 알게). HTTPS 뒤라 켠다.
server.forward-headers-strategy=native
# server.address 는 넣지 않는다. 컨테이너 안에서 127.0.0.1 로 묶으면 nginx 컨테이너가 8080 에 못 붙는다.
# 외부 격리는 호스트 포트를 publish 하지 않는 것으로 한다.

# ----------------------------------------------------------------
# 아래는 선택 — 필요할 때만 주석을 풀어 쓴다(괄호 안은 코드 기본값)
# ----------------------------------------------------------------

# === Gemini 모델 ===
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# 카테고리 자동 분류 임베딩 모델(gemini-embedding-001, 대체 없음)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# === AI 사용량 === 게스트가 많은 날은 펫 대화 1인 횟수를 낮춘다
# PET_CHAT_DAILY_LIMIT=10
# 영수증 인식 1인 하루 횟수(5)
# RECEIPT_DAILY_LIMIT=5
# AI 질문 문구 생성 / 일일 코멘트 AI (true). 경진대회 전날 밤 일일 코멘트는 관리자 화면에서 끈다.
# AI_QUESTION_WORDING_ENABLED=true
# AI_DAILY_COMMENT_ENABLED=true

# === 로그인 시도 제한 ===
# 같은 계정+IP 연속 실패 횟수(5) / 이메일별(20) / IP별(50) / 잠금 분(15)
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_EMAIL=20
# LOGIN_MAX_FAILURES_PER_IP=50
# LOGIN_LOCK_MINUTES=15

# === 기타 ===
# 탈퇴 유예 일수(30)
# ACCOUNT_DELETION_GRACE_DAYS=30
# CORS 허용 출처(쉼표 구분, 기본 http://localhost:3000,http://127.0.0.1:3000).
# 운영은 프론트와 API 가 같은 도메인(nginx 가 /api 를 넘김)이라 보통 바꿀 필요가 없다. 프론트를 다른 도메인에 둘 때만.
# CORS_ALLOWED_ORIGINS=https://vori.worldpick.co.kr
# 세션 쿠키 secure 를 임시로 끌 때(http 시험용). 운영에서는 두지 않는다.
# SESSION_COOKIE_SECURE=true
