# 배포 서버 /opt/vori/.env 초안 — 이 파일을 복사해 채운다. 채운 .env 는 절대 저장소에 올리지 않는다.
# 서버는 이 파일을 설정 파일(properties)로 읽어서, 환경변수 이름(DB_PASSWORD)도 설정 이름(vori.ai-judge.open-hour)도
# 그대로 쓸 수 있다. 값에 따옴표를 붙이지 않는다.

# === DB === (MySQL 을 같은 서버에 둔다 — 접속 주소는 코드에 127.0.0.1:3306/vori 로 고정)
# 다른 곳의 DB 를 쓰면 아래 줄의 주석을 풀어 바꾼다.
DB_USERNAME=vori
DB_PASSWORD=
# spring.datasource.url=jdbc:mysql://127.0.0.1:3306/vori?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# === 관리자 계정 === (#121)
# 관리자(admin@vori.com)가 아직 없을 때 첫 실행에서만 이 비밀번호로 만든다. 비우면 만들지 않는다.
# 저장소가 공개라 1234 같은 값은 누구나 안다 — 길고 다른 값으로. 시연 스크립트도 이 값을 VORI_ADMIN_PASSWORD 로 받는다.
ADMIN_PASSWORD=

# === Gemini === 서버 키는 유료(결제 등록) 프로젝트 키가 좋다. 무료는 하루 한도가 작고, 약관상 입력이 구글 서비스 개선에 쓰인다.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# === Google 로그인 === 같은 클라이언트 ID 를 프론트 빌드 때 REACT_APP_GOOGLE_CLIENT_ID 로도 넣는다.
# Google Cloud 콘솔 > 사용자 인증 정보 > 그 OAuth 클라이언트 > 「승인된 JavaScript 원본」에 https://도메인 추가.
GOOGLE_CLIENT_ID=

# === 판정 시각 === 평소 20시. 낮에 하는 발표·경진대회 기간에는 0 — 프론트 빌드의 REACT_APP_AI_ACTIVE_FROM_HOUR 도 같은 값으로.
vori.ai-judge.open-hour=20

# === AI 사용량 === 게스트가 많은 날은 펫 대화 1인 횟수를 낮춘다(기본 10).
# PET_CHAT_DAILY_LIMIT=10
# AI_QUESTION_WORDING_ENABLED=true
# AI_DAILY_COMMENT_ENABLED=true

# === HTTPS 를 켠 뒤에 === (http 로 IP 접속해 시험하는 동안 켜면 쿠키가 안 붙어 로그인이 안 된다)
# 세션 쿠키를 https 에서만 보낸다
# server.servlet.session.cookie.secure=true
# Nginx 가 넘겨 주는 X-Forwarded-Proto 를 믿는다(서버가 https 로 들어온 요청임을 알게)
# server.forward-headers-strategy=native

# === 백엔드를 밖에서 직접 못 부르게 === Nginx 만 8080 에 닿게 한다(보안 그룹에서 8080 을 막아도 된다)
server.address=127.0.0.1
